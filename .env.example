# Copy to backend/.env and frontend/.env.local for local development.
# This file contains only placeholders; use disposable local services.
#
# Backend: MongoDB connection and the exact browser origin allowed by CORS.
DATABASE_URL=mongodb://127.0.0.1:27017/bulk_mail_dev
FRONTEND_URL=http://localhost:5173

# Frontend: public URL for the Express API; VITE_ values are included in client code.
VITE_APP_BASE_URL=http://localhost:3000

# Current backend reads Gmail sender credentials from the first document in the
# MongoDB "user" collection. Do not store real mailbox credentials there. The
# project needs a server-side secret-management design before real mail use.
